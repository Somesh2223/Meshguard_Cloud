# Caddy terminates HTTPS (free Let's Encrypt certificate) and forwards
# everything, including WebSocket upgrades on /ws, to the Node server.
__DOMAIN__ {
	encode gzip
	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
